root = true

[*.html]
indent_style = space
indent_size = 2
max_line_length = 180

[app/js/*.js]
indent_style = space
indent_size = 2
max_line_length = 80

[app/css/*.css]
indent_style = space
indent_size = 2
max_line_length = 80